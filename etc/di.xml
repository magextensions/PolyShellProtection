<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magextensionsio\PolyShellProtection\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">magextensionsio_polyshell</argument>
            <argument name="handlers" xsi:type="array">
                <item name="security" xsi:type="object">Magextensionsio\PolyShellProtection\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <!-- Block file_info uploads through the vulnerable REST/Web API custom-option processor. -->
    <type name="Magento\Catalog\Model\Webapi\Product\Option\Type\File\Processor">
        <plugin name="magextensionsio_polyshell_block_webapi_custom_option_file_upload"
                type="Magextensionsio\PolyShellProtection\Plugin\BlockWebApiCustomOptionFileUpload"
                sortOrder="1"/>
    </type>

    <!-- Block actual multipart custom-option file uploads from storefront and admin order flows. -->
    <type name="Magento\Catalog\Model\Product\Option\Type\File\ValidatorFile">
        <plugin name="magextensionsio_polyshell_block_storefront_custom_option_file_upload"
                type="Magextensionsio\PolyShellProtection\Plugin\BlockStorefrontCustomOptionFileUpload"
                sortOrder="1"/>
    </type>
</config>
